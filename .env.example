# Copy to <hub>/.env and fill in only what your chosen providers need.
# Never commit the real .env.

# --- Netlify (deploy port, always required) --------------------------------
# Netlify → User settings → Applications → New access token
NETLIFY_AUTH_TOKEN=

# --- Gmail  (when mail.read or mail.send = "gmail") ------------------------
# OAuth 2.0 Desktop client in Google Cloud Console, Gmail API enabled, one-time
# consent for the mailbox that receives updates. Scopes: gmail.modify + gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- IMAP/SMTP  (when mail.read or mail.send = "imap") ---------------------
# Covers ProtonMail (via Proton Mail Bridge), Fastmail, iCloud, generic IMAP.
# For ProtonMail Bridge, use the host/port/credentials Bridge shows you.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Resend  (when mail.send = "resend") -----------------------------------
# Send-only. Resend → API Keys. The verified sender goes in clients.json (resend.from).
RESEND_API_KEY=

# Not needed when mail.read = "claude-connector" (Claude uses the Gmail
# connector via MCP instead of these credentials).
