#!/usr/bin/env node
/**
 * mailsite-deploy — the DEPLOY port for mailsite-agent.
 *
 * Agent-neutral CLI over pluggable hosting providers (bin/lib/deploy/*). The
 * host is chosen per client in clients.json:
 *
 *   "hosting": { "provider": "netlify",    "netlify":    { "siteName": "...", "siteId": "..." } }
 *   "hosting": { "provider": "cloudflare", "cloudflare": { "projectName": "...", "accountId": "..." } }
 *
 * Deploys are triggered by git push (both providers build on push / PR); this
 * CLI observes deploy state and resolves the preview/production URL. Prints JSON.
 *
 * Subcommands:
 *   preview <clientId> --branch <b> [--pr <n>] [--dir <path>] [--timeout <s>] [--interval <s>]
 *       Wait for the branch's deploy preview to be ready; print {state, url}.
 *   publish <clientId> [--dir <path>] [--timeout <s>] [--interval <s>]
 *       Wait for the latest production deploy to be ready; print {state, url}.
 *
 * `--dir` is accepted for forward-compat with direct-upload providers; the
 * git-triggered Netlify/Cloudflare providers ignore it.
 */
'use strict';

const { die, out, loadEnv, loadConfig, parseFlags, getClient, clientHosting, pollUntil } = require('./lib/common');

function loadProvider(name) {
  try { return require(`./lib/deploy/${name}`); }
  catch { die(`Unknown hosting provider: ${name} (have: netlify, cloudflare)`); }
}

async function main() {
  const [cmd, ...rest] = process.argv.slice(2);
  if (cmd === undefined || cmd === 'help' || cmd === '--help') {
    process.stdout.write(
      'mailsite-deploy <preview <clientId> --branch <b> [--pr <n>] | publish <clientId>>\n' +
      '  common flags: --dir <path> --timeout <sec> --interval <sec>\n');
    return;
  }

  const hubRoot = process.env.MAILSITE_HUB || process.cwd();
  loadEnv(hubRoot);
  const cfg = loadConfig(hubRoot);
  const { flags, positional } = parseFlags(rest);
  const [clientId] = positional;
  if (!clientId) die(`usage: mailsite-deploy ${cmd} <clientId> ...`);

  const client = getClient(cfg, clientId);
  const host = clientHosting(cfg, client);
  const provider = loadProvider(host.provider);

  const poll = (fn) => pollUntil(fn, {
    timeoutSec: Number(flags.timeout || 300),
    intervalSec: Number(flags.interval || 10),
  });
  const opts = { branch: flags.branch, pr: flags.pr, dir: flags.dir };

  switch (cmd) {
    case 'preview':
      if (!flags.branch) die('usage: preview <clientId> --branch <branch> [--pr <n>]');
      return out({ clientId, provider: host.provider, ...(await provider.preview(cfg, client, host, opts, poll)) });
    case 'publish':
      return out({ clientId, provider: host.provider, ...(await provider.publish(cfg, client, host, opts, poll)) });
    default:
      die(`Unknown command: ${cmd}`);
  }
}

main().catch((e) => die(e && e.stack ? e.stack : e));
