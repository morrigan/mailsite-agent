{
  "$comment": "Symlink this to <hub>/.claude/settings.json (see adapters/claude-code/install.md). Pre-grants the capability CLIs + git/gh so headless `claude -p` runs never prompt. Deliberately does NOT allow arbitrary Bash.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Bash(node mailsite-agent/bin/mailsite-mail:*)",
      "Bash(node mailsite-agent/bin/mailsite-deploy:*)",
      "Bash(mailsite-agent/bin/mailsite-mail:*)",
      "Bash(mailsite-agent/bin/mailsite-deploy:*)",
      "Bash(mailsite-agent/scripts/optimize-image.sh:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(mkdir:*)",
      "Bash(rmdir:*)",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude_ai_Gmail__create_label",
      "mcp__claude_ai_Gmail__label_message",
      "mcp__claude_ai_Gmail__update_message_labels",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__send_message"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(**/.env)"
    ]
  },
  "enableAllProjectMcpServers": false
}
