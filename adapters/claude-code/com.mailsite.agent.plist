<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for mailsite-agent (Claude Code adapter).

  Install:
    1. Edit the two REPLACE_ME paths below to your absolute hub path.
    2. cp this file to ~/Library/LaunchAgents/com.mailsite.agent.plist
    3. launchctl load ~/Library/LaunchAgents/com.mailsite.agent.plist
    Unload: launchctl unload ~/Library/LaunchAgents/com.mailsite.agent.plist

  Runs every 600s (StartInterval). The lock in run-cron.sh prevents overlap.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mailsite.agent</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_ME/hub/mailsite-agent/adapters/claude-code/run-cron.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>REPLACE_ME/hub/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_ME/hub/logs/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
